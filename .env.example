# Copy to .env and fill in. Never commit .env.

# Neon connection string (Neon console -> Connect). Keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: a separate database/branch for `go test` (defaults to DATABASE_URL).
# TEST_DATABASE_URL=

# API
API_ADDR=:8080

# Mock accounting server
MOCK_ADDR=:9090
MOCK_FAIL_RATE=0.20
MOCK_HANG_RATE=0.10
MOCK_HANG_FOR=5s

# Sync worker
ACCOUNTING_URL=http://localhost:9090
WORKER_CONCURRENCY=8
WORKER_POLL_INTERVAL=1s
WORKER_HTTP_TIMEOUT=8s
WORKER_LEASE=15s
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE=2s
WORKER_BACKOFF_MAX=1m
# WORKER_ID defaults to hostname-pid

# Stretch: POST /ask. Leave the key empty to use the stub model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
